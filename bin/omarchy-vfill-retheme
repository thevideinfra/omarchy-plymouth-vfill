#!/bin/bash

# Recolour the installed omarchy-vfill Plymouth theme from the active Omarchy
# theme and rebuild the initramfs. Run as root; safe to run by hand -- this is
# the command the user runs after changing the Omarchy theme, since nothing
# does it automatically:
#
#   sudo /usr/local/lib/omarchy-vfill/bin/omarchy-vfill-retheme --force
#
#   omarchy-vfill-retheme                     recolour if needed, then rebuild
#   omarchy-vfill-retheme --check             report whether a retheme is needed
#   omarchy-vfill-retheme --force             republish and rebuild even if current
#   omarchy-vfill-retheme --theme-dir <path>  use <path> instead of resolving one
#
# --check performs no writes and needs no privileges, so a caller can decide
# whether to prompt at all before elevating. Its exit codes are:
#
#   0  a retheme is needed
#   3  the splash is already current; nothing to do
#   1  an error -- no active theme, or no colour/logo to build from
#   2  a usage error (--check with --force)
#
# "Already current" is 3 rather than 1 deliberately: a caller that cannot tell
# it apart from an error reads a broken theme as "nothing to do". Anything that
# is neither 0 nor 3 is a failure and must be treated as one.
#
# The privileged (non---check) exit codes are unchanged: 0 on success, non-zero
# on any failure.
#
# --force skips the marker comparison, so updated theme files (after a git pull
# and re-install) are republished; it cannot be combined with --check.

set -uo pipefail

REPO=$(cd -- "$(dirname -- "$(readlink -f "$0")")/.." && pwd)
THEME_DEST=${VFILL_THEME_DEST:-/usr/share/plymouth/themes/omarchy-vfill}
OMARCHY_PATH=${OMARCHY_PATH:-/usr/share/omarchy}
# Overridable only so the tests can point it at a scratch file, exactly like
# VFILL_THEME_DEST; sudo's env_reset and pkexec both drop it on a real run.
LOCK_FILE=${VFILL_LOCK_FILE:-/run/lock/omarchy-vfill.lock}

source "$REPO/lib/vfill.sh"

# This script runs as root, where HOME is /root: pkexec sets it and sudo resets
# it under the default env_reset policy. The Omarchy theme belongs to the
# invoking user, so recover their home rather than trusting HOME.
vfill_invoking_home() {
  local user_home=""

  if [[ -n ${PKEXEC_UID:-} ]]; then
    user_home=$(getent passwd "$PKEXEC_UID" | cut -d: -f6)
  elif [[ -n ${SUDO_USER:-} ]]; then
    user_home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
  fi

  [[ -n $user_home ]] || user_home="$HOME"
  printf '%s\n' "$user_home"
}

THEME_DIR_OPT=""
CHECK_ONLY=false
FORCE=false

while (($# > 0)); do
  case "$1" in
    --check) CHECK_ONLY=true ;;
    --force) FORCE=true ;;
    --theme-dir)
      # Refused before shifting, the same flaw install.sh's --mode had. A
      # missing or empty value left THEME_DIR_OPT empty, which falls through to
      # the invoking user's $HOME below -- so `--theme-dir "$maybe_empty"`
      # silently rethemed from a directory nobody named. The shift also failed
      # silently at $#==0, leaving "$1" as the option itself.
      if (($# < 2)) || [[ -z $2 ]]; then
        echo "omarchy-vfill-retheme: --theme-dir needs a value" >&2
        exit 1
      fi
      THEME_DIR_OPT="$2"
      shift
      ;;
    *) echo "omarchy-vfill-retheme: unknown option: $1" >&2; exit 1 ;;
  esac
  shift
done

if $CHECK_ONLY && $FORCE; then
  echo "omarchy-vfill-retheme: --force cannot be combined with --check" >&2
  exit 2
fi

if ! $CHECK_ONLY; then
  if ((EUID != 0)); then
    echo "omarchy-vfill-retheme: must run as root" >&2
    exit 1
  fi

  # Serialise privileged runs. omarchy-theme-set releases its own lock before
  # running hooks, so two quick theme changes can start two rethemes at once;
  # unserialised they would interleave the directory swap below and run two
  # initramfs builds into the same image. Blocking is fine: the later run then
  # reads the theme as it is once the earlier one has finished, so the last
  # theme set wins. /run/lock is root-owned 0755, so no user can pre-create
  # or redirect this file; >> avoids truncating anything.
  exec {lock_fd}>>"$LOCK_FILE" || {
    echo "omarchy-vfill-retheme: cannot open lock $LOCK_FILE" >&2
    exit 1
  }
  flock "$lock_fd" || {
    echo "omarchy-vfill-retheme: cannot take lock $LOCK_FILE" >&2
    exit 1
  }
fi

if [[ -n $THEME_DIR_OPT ]]; then
  CURRENT_THEME="$THEME_DIR_OPT"
elif [[ -n ${VFILL_THEME_DIR:-} ]]; then
  CURRENT_THEME="$VFILL_THEME_DIR"
else
  CURRENT_THEME="$(vfill_invoking_home)/.local/state/omarchy/current/theme"
fi

if [[ ! -d $CURRENT_THEME ]]; then
  echo "omarchy-vfill-retheme: no active Omarchy theme at $CURRENT_THEME" >&2
  exit 1
fi

background=$(vfill_read_color "$CURRENT_THEME/colors.toml" background) || {
  echo "omarchy-vfill-retheme: no background in $CURRENT_THEME/colors.toml" >&2
  exit 1
}
foreground=$(vfill_read_color "$CURRENT_THEME/colors.toml" foreground) || {
  echo "omarchy-vfill-retheme: no foreground in $CURRENT_THEME/colors.toml" >&2
  exit 1
}
logo_color=$(vfill_logo_color "$CURRENT_THEME/colors.toml") || {
  echo "omarchy-vfill-retheme: no accent or foreground in $CURRENT_THEME/colors.toml" >&2
  exit 1
}
logo=$(vfill_resolve_logo "$CURRENT_THEME" "$OMARCHY_PATH") || {
  echo "omarchy-vfill-retheme: no logo available" >&2
  exit 1
}

if ! $FORCE && vfill_marker_matches "$THEME_DEST/.vfill-marker" "$background" "$foreground" "$logo" "$logo_color"; then
  # 3, not 1: every error above exits 1 or 2, so a caller can tell "already
  # current" from "this theme is broken" and refuse to act on the latter.
  $CHECK_ONLY && exit 3
  echo "omarchy-vfill-retheme: already current, nothing to do"
  exit 0
fi

$CHECK_ONLY && exit 0

# Resolve the initramfs rebuild command before writing anything: a system
# that cannot rebuild its initramfs must not end up with a half-published
# theme it can never boot with.
rebuild=$(vfill_initramfs_command) || {
  echo "omarchy-vfill-retheme: no initramfs tool found; nothing published" >&2
  exit 1
}

if [[ -n ${PKEXEC_UID:-} ]]; then
  invoking_uid=$PKEXEC_UID
elif [[ -n ${SUDO_UID:-} ]]; then
  invoking_uid=$SUDO_UID
else
  invoking_uid=$(id -u)
fi

# The theme-provided unlock.png is user-controlled content that
# omarchy-theme-set copies with cp -r, which preserves symlinks. Open it as
# the invoking user's file before staging and require the OPENED inode -- not
# the path -- to be a regular file that user owns, so a symlink to a
# root-owned file (e.g. /etc/shadow) is refused rather than published
# world-readable into the initramfs. The trusted $OMARCHY_PATH/logo.svg
# fallback is package-owned system content and is exempt.
logo_fd=""
if [[ $logo != "$OMARCHY_PATH/logo.svg" ]]; then
  logo_fd_capture=$(mktemp)
  if vfill_open_user_file "$logo" "$invoking_uid" >"$logo_fd_capture"; then
    logo_fd=$(<"$logo_fd_capture")
  else
    rm -f "$logo_fd_capture"
    echo "omarchy-vfill-retheme: refusing to publish $logo: not a regular file owned by uid $invoking_uid" >&2
    exit 1
  fi
  rm -f "$logo_fd_capture"
fi

staging=$(mktemp -d)
new_dest=""

cleanup() {
  [[ -n $logo_fd ]] && exec {logo_fd}<&- 2>/dev/null
  rm -rf -- "$staging"
  [[ -n $new_dest ]] && rm -rf -- "$new_dest"
}
trap cleanup EXIT

# Pass the already-resolved $logo through rather than letting
# vfill_stage_theme resolve it again: a second lookup would leave a TOCTOU
# window between this script's resolution (and, for unlock.png, its
# ownership check above) and the copy staging performs.
vfill_stage_theme "$REPO" "$staging" "$CURRENT_THEME" "$OMARCHY_PATH" "$logo" || {
  echo "omarchy-vfill-retheme: staging failed" >&2
  exit 1
}

# Overwrite the staged logo with exactly the bytes read from the verified
# descriptor, so the bytes published are the ones that were checked, not a
# fresh read of the path that could have been swapped after the check.
if [[ -n $logo_fd ]]; then
  cat <&"$logo_fd" >"$staging/logo.png" || {
    echo "omarchy-vfill-retheme: failed to read the verified logo" >&2
    exit 1
  }
  exec {logo_fd}<&-
  logo_fd=""

  # Hash the bytes just copied from the verified descriptor, never the path:
  # root re-reading the path could hash a file swapped in since the check and
  # put a root-only file's digest into the world-readable marker. Unchanged
  # artwork gives the same digest as --check's hash of the path, so the theme
  # still reads as current afterwards.
  vfill_write_marker "$staging/.vfill-marker" "$background" "$foreground" "$logo" "$logo_color" "$staging/logo.png" || {
    echo "omarchy-vfill-retheme: failed to write the marker" >&2
    exit 1
  }
fi

# Publish atomically: build the new theme directory next to the live one,
# verify every file lands, then swap it into place with a rename. A failure
# before the swap leaves the previous theme untouched.
#
# The marker is deliberately NOT part of the published set. It claims the
# theme is live in the initramfs, which is only true once
# plymouth-set-default-theme and the rebuild have both succeeded, so it is
# installed last. Until then no marker exists at all -- not even the previous
# one -- so any failure or kill in between leaves the next --check asking for
# a retheme instead of reporting "already current" forever.
new_dest="$THEME_DEST.new.$$"
rm -rf -- "$new_dest"
install -d -m 0755 -o root -g root "$new_dest" || {
  echo "omarchy-vfill-retheme: failed to create $new_dest" >&2
  exit 1
}

for file in "$staging"/*; do
  install -m 0644 -o root -g root "$file" "$new_dest/$(basename "$file")" || {
    echo "omarchy-vfill-retheme: failed to publish $(basename "$file")" >&2
    exit 1
  }
done

rm -f -- "$THEME_DEST/.vfill-marker" || {
  echo "omarchy-vfill-retheme: failed to remove the previous marker" >&2
  exit 1
}

old_dest=""
if [[ -d $THEME_DEST ]]; then
  old_dest="$THEME_DEST.old.$$"
  mv -T -- "$THEME_DEST" "$old_dest" || {
    echo "omarchy-vfill-retheme: failed to move the previous theme aside" >&2
    exit 1
  }
fi

if ! mv -T -- "$new_dest" "$THEME_DEST"; then
  echo "omarchy-vfill-retheme: failed to swap in the new theme" >&2
  [[ -n $old_dest ]] && mv -T -- "$old_dest" "$THEME_DEST"
  exit 1
fi
new_dest=""
[[ -n $old_dest ]] && rm -rf -- "$old_dest"

plymouth-set-default-theme omarchy-vfill || {
  echo "omarchy-vfill-retheme: plymouth-set-default-theme failed" >&2
  exit 1
}

echo "omarchy-vfill-retheme: rebuilding initramfs with $rebuild"
$rebuild || {
  echo "omarchy-vfill-retheme: initramfs rebuild failed" >&2
  exit 1
}

# Only now is the recoloured theme actually what boots, so only now may the
# marker say so.
install -m 0644 -o root -g root "$staging/.vfill-marker" "$THEME_DEST/.vfill-marker" || {
  echo "omarchy-vfill-retheme: rebuilt, but failed to write the marker; the next theme change will retheme again" >&2
  exit 1
}
